#include "Pods/Target Support Files/Pods-nrd-mac-client/Pods-nrd-mac-client.debug.xcconfig"
UUREMOTE_ENVIRONMENT = DEBUG
//Code sign
CODE_SIGN_IDENTITY = Developer ID Application: Hangzhou Bobo Technology Co Ltd (PU9BNSBJW7)

//App
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
APP_IDENTIFIER = com.netease.uuremote
ARCH_ENV = $(ARCHS_STANDARD)
// DEBUG flag can present more logs
OTHER_SWIFT_FLAG = ${UUREMOTE_ENVIRONMENT}
