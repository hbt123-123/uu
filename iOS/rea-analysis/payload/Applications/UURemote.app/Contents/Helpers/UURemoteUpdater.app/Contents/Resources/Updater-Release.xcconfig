#include "Pods/Target Support Files/Pods-updater/Pods-updater.release.xcconfig"
UUREMOTE_UPDATER_ENVIRONMENT = RELEASE // 官网渠道
//Code sign
CODE_SIGN_IDENTITY = Developer ID Application: Hangzhou Bobo Technology Co Ltd (PU9BNSBJW7)
//App
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
APP_IDENTIFIER = com.netease.uuremote.updater
ARCH_ENV = $(ARCHS_STANDARD)
// DEBUG flag can present more logs
OTHER_SWIFT_FLAG = ${UUREMOTE_UPDATER_ENVIRONMENT}
